# OpenTelemetry Export Endpoints
OTEL_EXPORTER_OTLP_LOGS_ENDPOINT=http://localhost:65005/insert/opentelemetry/v1/logs
# OTEL_EXPORTER_OTLP_METRICS_ENDPOINT=http://localhost:65006/insert/opentelemetry/v1/metrics
OTEL_EXPORTER_OTLP_METRICS_ENDPOINT=http://localhost:65005/api/v1/write
OTEL_EXPORTER_OTLP_TRACES_ENDPOINT=http://localhost:65004/insert/opentelemetry/v1/traces
OTEL_EXPORTER_OTLP_LOGS_PROTOCOL=http/protobuf
OTEL_EXPORTER_OTLP_METRICS_PROTOCOL=http/protobuf
OTEL_EXPORTER_OTLP_TRACES_PROTOCOL=http/protobuf

# VictoriaMetrics Configuration
VM_HTTP_PORT=65006 # VictoriaMetrics HTTP API and UI port
VM_DATA_PATH=./victoria-data # Local path for persistent data storage
VM_MEMORY_LIMIT=10G
VM_STORAGE_LIMIT=100G # vm doesn't support such a param
VM_MIN_FREE_DISK_SPACE=10737418240 # 10GB
VM_RETENTION_PERIOD=120d
VM_CPU_CORES=2
VM_ALLOWED_MEMORY_PERCENT=65
VM_MIN_SCRAPE_INTERVAL=1s

# vmagent Configuration
VMA_HTTP_PORT=65007 # vmagent Prometheus push endpoint port
VMA_JSON_PORT=65008 # vmagent JSON API port
VMA_AUTH_TOKEN= # Token for authenticating API Gateway requests

# VictoriaLogs Configuration
VLO_HTTP_PORT=65005
VLO_STORAGE_PATH=./victoria-logs
VLO_MAX_LOG_SIZE=500MB
VLO_RETENTION_PERIOD=30d
VLO_MAX_LOGS=1000000
VLO_AUTH_API_KEY=asldNALSDJNjkasdAS

# Victoriatraces Configuration
VTR_HTTP_PORT=65004
VTR_STORAGE_PATH=./victoria-traces
